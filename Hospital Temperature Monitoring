#include <stdio.h>

int main()
{
    float temp[2][3][4];
    float total, average;
    float highest;
    int i, j, k;
    int count = 0;

    // Input temperatures
    for(i = 0; i < 2; i++)
    {
        printf("\nWard %d\n", i + 1);

        for(j = 0; j < 3; j++)
        {
            printf("\nPatient %d\n", j + 1);

            for(k = 0; k < 4; k++)
            {
                printf("Enter reading %d: ", k + 1);
                scanf("%f", &temp[i][j][k]);

                if(temp[i][j][k] > 37.5)
                    count++;
            }
        }
    }

    // Calculate patient averages and ward highest temperature
    for(i = 0; i < 2; i++)
    {
        highest = temp[i][0][0];

        for(j = 0; j < 3; j++)
        {
            total = 0;

            for(k = 0; k < 4; k++)
            {
                total += temp[i][j][k];

                if(temp[i][j][k] > highest)
                    highest = temp[i][j][k];
            }

            average = total / 4.0;

            printf("\nWard %d Patient %d Average: %.2f",
                   i + 1, j + 1, average);

            if(average > 38)
                printf("\nPatient %d in Ward %d exceeds 38 degrees.",
                       j + 1, i + 1);
        }

        printf("\nHighest temperature in Ward %d: %.2f\n",
               i + 1, highest);
    }

    printf("\nTotal readings above 37.5: %d", count);

    return 0;
}
