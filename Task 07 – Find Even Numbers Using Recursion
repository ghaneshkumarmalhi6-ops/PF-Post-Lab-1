#include <stdio.h>

void findEven(int arr[], int index)
{
    if(index == 10)
    {
        return;
    }

    if(arr[index] % 2 == 0)
    {
        printf("%d ", arr[index]);
    }

    findEven(arr, index + 1);
}

int main()
{
    int arr[10];
    int i;

    printf("Enter 10 integers:\n");

    for(i = 0; i < 10; i++)
    {
        scanf("%d", &arr[i]);
    }

    printf("Even Numbers: ");

    findEven(arr, 0);

    return 0;
}
