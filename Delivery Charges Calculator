#include <stdio.h>

float calculateBase(float weight)
{
    if(weight <= 2)
        return 200;
    else if(weight <= 5)
        return 400;
    else
        return 700;
}

void calculateDelivery(float weight, float distance, int member)
{
    float base, distanceCharge = 0;
    float total, discount = 0, finalAmount;

    base = calculateBase(weight);

    if(distance > 10)
        distanceCharge = distance * 20;

    total = base + distanceCharge;

    if(member == 1 && total > 1000)
        discount = total * 0.10;

    finalAmount = total - discount;

    printf("\nBase Charges: Rs. %.2f", base);
    printf("\nDistance Charges: Rs. %.2f", distanceCharge);
    printf("\nDiscount: Rs. %.2f", discount);
    printf("\nFinal Amount: Rs. %.2f", finalAmount);
}

int main()
{
    float weight, distance;
    int member;

    printf("Enter parcel weight (kg): ");
    scanf("%f", &weight);

    printf("Enter delivery distance (km): ");
    scanf("%f", &distance);

    printf("Are you a member? (1=Yes, 0=No): ");
    scanf("%d", &member);

    if(weight <= 0 || distance < 0 ||
       (member != 0 && member != 1))
    {
        printf("Invalid input.");
        return 0;
    }

    calculateDelivery(weight, distance, member);

    return 0;
}
